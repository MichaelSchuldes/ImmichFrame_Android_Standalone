<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/layoutPhotoInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_text_overlay"
            android:orientation="vertical"
            android:gravity="start"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutPhotoDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgPhotoDateIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="#FFFFFF"
                    android:contentDescription="Date" />

                <TextView
                    android:id="@+id/txtPhotoDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.5"
                    android:shadowRadius="4"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPhotoLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgPhotoLocationIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_place_pin"
                    android:tint="#FFFFFF"
                    android:contentDescription="Location" />

                <TextView
                    android:id="@+id/txtPhotoLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.5"
                    android:shadowRadius="4"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_text_overlay"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:shadowColor="#FF000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="4"
            android:text=""
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <View
            android:id="@+id/dimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#000000"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/infoOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A0000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/infoCardContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="24dp"
                android:orientation="vertical"
                android:background="@drawable/bg_info_overlay"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/txtInfoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/btnInfoClose"
                        android:text="Photo Details"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnInfoClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="#CCCCCC"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="20dp">

                        <ImageView
                            android:id="@+id/imgQrCode"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_qr_frame"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="QR Code" />

                        <TextView
                            android:id="@+id/txtQrAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Scan to open in Immich"
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="320dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="320dp">

                        <TextView
                            android:id="@+id/txtInfoDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="5dp"
                            android:textColor="#EDEDED"
                            android:textSize="16sp" />
                    </ScrollView>

                    <!-- Column 3: Interactive Map with GPS Pin and City/Country -->
                    <LinearLayout
                        android:id="@+id/layoutMapSection"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Location Header: City and Country -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_place_pin"
                                android:tint="#E53935"
                                android:contentDescription="Map Pin" />

                            <TextView
                                android:id="@+id/txtMapLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City, Country"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <!-- Map Container (Clickable to switch between city and country zoom) -->
                        <FrameLayout
                            android:id="@+id/layoutMapContainer"
                            android:layout_width="300dp"
                            android:layout_height="180dp"
                            android:background="@drawable/bg_qr_frame"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/imgMapView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Photo Location Map" />

                            <!-- Zoom Mode Badge in bottom-right corner -->
                            <LinearLayout
                                android:id="@+id/layoutMapZoomBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_text_overlay"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/txtMapZoom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="City view · Tap for country"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtMapHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Tap map to switch between city and country"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtInfoUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#64B5F6"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- Settings Indicator Pill / Badge that appears when swiping down from top -->
        <FrameLayout
            android:id="@+id/settingsIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_settings_badge"
            android:elevation="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSettingsGear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="Settings" />
        </FrameLayout>

        <!-- Offline Indicator Bubble in top-left corner -->
        <LinearLayout
            android:id="@+id/layoutOfflineIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_offline_bubble"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgOfflineIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_wifi_off"
                android:contentDescription="Offline" />

            <TextView
                android:id="@+id/txtOfflineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Offline · Cycling cache" />
        </LinearLayout>
</FrameLayout>