<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Immich Connection">
        <EditTextPreference
            android:key="immich_server_url"
            android:title="Immich Server URL"
            android:dialogTitle="Immich Server URL"
            android:summary="e.g. http://192.168.1.100:2283"
            android:inputType="textUri" />
        <EditTextPreference
            android:key="immich_api_key"
            android:title="Immich API Key"
            android:dialogTitle="Immich API Key"
            android:summary="API key generated in Immich account settings" />
        <Preference
            android:key="test_connection"
            android:layout="@layout/pref_test_button" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Content &amp; Filters">
        <SwitchPreferenceCompat
            android:key="filter_favorites_only"
            android:defaultValue="false"
            android:title="Favorites Only"
            android:summary="Only display assets marked as favorite" />
        <SwitchPreferenceCompat
            android:key="filter_include_memories"
            android:defaultValue="false"
            android:title="Include Memories"
            android:summary="Include 'On this day' memories" />
        <EditTextPreference
            android:key="filter_album_ids"
            android:defaultValue=""
            android:title="Albums"
            android:dialogTitle="Filter by Albums"
            android:summary="Comma-separated album names or UUIDs" />
        <EditTextPreference
            android:key="filter_person_ids"
            android:defaultValue=""
            android:title="Include Person IDs"
            android:dialogTitle="Include Person IDs"
            android:summary="Optional comma-separated Person UUIDs to include" />
        <EditTextPreference
            android:key="filter_excluded_person_ids"
            android:defaultValue=""
            android:title="Exclude People"
            android:dialogTitle="Exclude People"
            android:summary="Comma-separated names or UUIDs of people to exclude" />
        <EditTextPreference
            android:key="filter_tag_ids"
            android:defaultValue=""
            android:title="Tag IDs"
            android:dialogTitle="Tag IDs"
            android:summary="Optional comma-separated Tag UUIDs" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Display Options">
        <EditTextPreference
            android:key="slideshow_interval"
            android:defaultValue="20"
            android:title="Interval (seconds)"
            android:dialogTitle="Interval in seconds"
            android:inputType="number" />
        <EditTextPreference
            android:key="transition_duration"
            android:defaultValue="1.0"
            android:title="Transition Duration (seconds)"
            android:dialogTitle="Transition Duration in seconds"
            android:inputType="numberDecimal" />
        <SwitchPreferenceCompat
            android:key="splitView"
            android:defaultValue="false"
            android:title="SplitView for Portraits"
            android:summary="Display two portrait photos side-by-side" />
        <SwitchPreferenceCompat
            android:key="imageFill"
            android:defaultValue="false"
            android:title="Fill Screen (Crop)" />
        <SwitchPreferenceCompat
            android:key="imageZoom"
            android:defaultValue="false"
            android:title="Slow Zoom Effect" />
        <SwitchPreferenceCompat
            android:key="blurredBackground"
            android:defaultValue="true"
            android:title="Blurred Letterbox Background" />
        <SwitchPreferenceCompat
            android:key="showPhotoDate"
            android:defaultValue="true"
            android:title="Show Photo Date" />
        <EditTextPreference
            android:key="photoDateFormat"
            android:defaultValue="EEE, MMM d, yyyy"
            android:title="Photo Date Format"
            android:dialogTitle="Photo Date Format" />
        <SwitchPreferenceCompat
            android:key="showImageLocation"
            android:defaultValue="true"
            android:title="Show Photo Location" />
        <EditTextPreference
            android:key="imageLocationFormat"
            android:defaultValue="City, Country"
            android:title="Photo Location Format"
            android:dialogTitle="Location Format (e.g. City, Country)" />
        <SwitchPreferenceCompat
            android:key="showClock"
            android:defaultValue="true"
            android:title="Show Clock" />
        <SwitchPreferenceCompat
            android:key="showCurrentDate"
            android:defaultValue="true"
            android:title="Show Current Date" />
        <EditTextPreference
            android:key="clockFormat"
            android:defaultValue="h:mm a"
            android:title="Clock Time Format"
            android:dialogTitle="Clock Time Format" />
        <EditTextPreference
            android:key="primaryColor"
            android:defaultValue="#FFFFFF"
            android:title="Text Color (Hex)"
            android:dialogTitle="Text Color (e.g. #FFFFFF)" />
        <EditTextPreference
            android:key="baseFontSize"
            android:defaultValue="24px"
            android:title="Base Font Size"
            android:dialogTitle="Base Font Size (e.g. 24px)" />
        <SwitchPreferenceCompat
            android:key="settingsLock"
            android:defaultValue="false"
            android:title="Lock Settings Access" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Active Times">
        <SwitchPreferenceCompat
            android:key="activeTimes"
            android:defaultValue="false"
            android:title="Set Active Hours?" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_edit"
            android:summary="Per-weekday on/off times"
            android:title="Edit Active Schedule" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_admin"
            android:summary="Allow the frame to turn off the screen and sleep the device during inactive hours"
            android:title="Enable Screen-Off Permission" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Android Settings">
        <Preference
            android:key="androidSettings"
            android:title="Launch Android Settings" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Interactions">
        <Preference
            android:key="interactions"
            android:selectable="false"
            android:summary="⬆️ Open Settings\n🆗 Play/Pause\n⬅️ Previous Image\n➡️ Next Image\n👇 Open Settings (swipe)" />
    </PreferenceCategory>

    <Preference
        android:key="closeSettings"
        android:layout="@layout/pref_close_button" />
</PreferenceScreen>